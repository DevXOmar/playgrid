{
  "name": "playgrid",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "infra:up": "docker compose -f docker-compose.infra.yml up -d postgres redis",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "dev": "pnpm --parallel --filter @playgrid/api --filter @playgrid/web dev",
    "dev:web": "pnpm --filter @playgrid/web dev",
    "dev:api": "pnpm --filter @playgrid/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @playgrid/api test",
    "test:integration": "pnpm --filter @playgrid/api test:integration",
    "test:e2e": "pnpm --filter @playgrid/web test:e2e",
    "test:race": "pnpm --filter @playgrid/api test:race",
    "prisma:migrate": "pnpm db:migrate",
    "prisma:seed": "pnpm db:seed",
    "db:migrate": "pnpm --filter @playgrid/api prisma:migrate",
    "db:seed": "pnpm --filter @playgrid/api prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "typescript": "^5.6.3"
  }
}
